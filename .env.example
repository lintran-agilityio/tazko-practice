# Copy to .env and fill in. Never commit .env.

# Local Supabase (values are printed by `npm run db:start`).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Company email domains allowed to sign in or be invited (G-20), comma separated.
# The real domain stays in your local .env, not in the repo.
ALLOWED_EMAIL_DOMAINS=example.com

# Passwords for the seed users (M2b). Choose your own; never commit them.
SEED_USER_PASSWORD=replace-with-a-local-password

# Same domains for the browser hint on Sign in (build time, comma separated). A hint only;
# the database decides (G-20). Use the same real domain in your local .env.
VITE_ALLOWED_EMAIL_DOMAINS=example.com
